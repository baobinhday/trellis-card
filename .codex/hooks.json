{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -X utf8 .codex/hooks/session-start.py",
            "timeout": 30,
            "statusMessage": "Loading Lean Trellis context",
            "additionalContextLimit": 2500
          }
        ]
      }
    ]
  }
}
